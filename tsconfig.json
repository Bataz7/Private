{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "#jsx",
    "paths": { "#jsx/jsx-runtime": ["./dashboard/jsx/jsx-runtime.ts"], "#jsx/jsx-dev-runtime": ["./dashboard/jsx/jsx-runtime.ts"] }
  },
  "include": ["src", "dashboard", "tests"]
}
