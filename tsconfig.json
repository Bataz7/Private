{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "#jsx",
    "paths": { "#jsx/jsx-runtime": ["./src/web/jsx/jsx-runtime.ts"], "#jsx/jsx-dev-runtime": ["./src/web/jsx/jsx-runtime.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["src/dashboard/public"]
}
