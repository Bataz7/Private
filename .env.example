DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id
GUILD_ID=your_default_server_id_optional
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# The public address of the dashboard, with https:// and no trailing slash. With a domain it looks like https://rift.example.com
# In the Discord Developer Portal (OAuth2 > Redirects) add exactly: <DASHBOARD_URL>/auth/callback
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000

# At least 32 random characters. The dashboard refuses to start with a short or default value.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_value

# Optional. Behind a domain with https the dashboard already trusts one proxy (hosting panel, Nginx, Cloudflare).
# Set TRUST_PROXY=0 only if the domain points straight at the app with no proxy in front.
# TRUST_PROXY=1
