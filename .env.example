# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى GitHub
# Copy to .env and fill in — never commit .env

# ===== البوت | Bot =====
DISCORD_TOKEN=                       # توكن البوت (من Developer Portal → Bot)
DEFAULT_LANG=ar                      # اللغة الافتراضية للسيرفرات الجديدة: ar أو en
OWNER_IDS=                           # آيديات المالكين مفصولة بفاصلة (اختياري)
OWNER_GUILD_ID=                      # سيرفرك الخاص لأوامر /bot-control وإشعارات دخول البوت (اختياري)
OWNER_LOG_CHANNEL_ID=                # روم إشعارات دخول/خروج البوت (اختياري)
OWNER_STATS_CHANNEL_ID=              # روم الإحصائيات الحية (اختياري)
DATA_DIR=                            # مجلد البيانات (الافتراضي: data/)

# ===== لوحة التحكم | Dashboard =====
ENABLE_DASHBOARD=1
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_URL=https://dashboard.example.com   # الدومين الرسمي (https) — Redirect: <هذا>/callback
FORCE_HTTPS=1
DASHBOARD_PORT=25591
SESSION_SECRET=
FORWARDED_ALLOW_IPS=*
SUPPORT_URL=https://discord.gg/xxxx
# SSL_CERTFILE=/etc/letsencrypt/live/dashboard.example.com/fullchain.pem
# SSL_KEYFILE=/etc/letsencrypt/live/dashboard.example.com/privkey.pem

# تسجيل الإيموجيات تلقائياً عند التشغيل (0 للإيقاف)
AUTO_EMOJIS=1
