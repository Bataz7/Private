# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى GitHub

# ===== البوت =====
# توكن البوت (من Developer Portal → Bot). فعّل هناك: SERVER MEMBERS INTENT و MESSAGE CONTENT INTENT
DISCORD_TOKEN=
# آيديات المالكين مفصولة بفاصلة (اختياري)
OWNER_IDS=
# سيرفرك الخاص لأوامر /التحكم-بالبوت وإشعارات دخول البوت (اختياري)
OWNER_GUILD_ID=
# روم إشعارات دخول/خروج البوت (اختياري)
OWNER_LOG_CHANNEL_ID=
# روم الإحصائيات الحية (اختياري)
OWNER_STATS_CHANNEL_ID=
# مجلد البيانات (الافتراضي: data/) — البوت واللوحة لازم يستخدمون نفس المجلد
DATA_DIR=
# تسجيل الإيموجيات الخاصة تلقائياً عند التشغيل (0 للإيقاف)
AUTO_EMOJIS=1
# حجم كاش الرسائل (للوق الحذف والتعديل) وكاش الأعضاء — أقل = ذاكرة أقل
MESSAGE_CACHE=300
MEMBER_CACHE=1500

# ===== لوحة التحكم (برنامج منفصل: bun run dashboard) =====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# الدومين الرسمي (https) — Redirect في Developer Portal: <هذا>/callback
DASHBOARD_URL=https://dashboard.example.com
FORCE_HTTPS=1
DASHBOARD_PORT=25591
SESSION_SECRET=
FORWARDED_ALLOW_IPS=*
SUPPORT_URL=https://discord.gg/xxxx
# SSL_CERTFILE=/etc/letsencrypt/live/dashboard.example.com/fullchain.pem
# SSL_KEYFILE=/etc/letsencrypt/live/dashboard.example.com/privkey.pem
