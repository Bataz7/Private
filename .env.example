# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى GitHub
# Copy to .env and fill in — never commit .env

# Discord application (Developer Portal → OAuth2)
DISCORD_CLIENT_ID=1549657352385597491
DISCORD_CLIENT_SECRET=

# الدومين الرسمي للوحة (https). يجب أن يطابق الـ Redirect في ديسكورد: ${DASHBOARD_URL}/callback
# Public https URL of the dashboard. Discord redirect must be:  <this>/callback
DASHBOARD_URL=https://dashboard.example.com

# 1 = حوّل http إلى https وفعّل الكوكيز الآمنة | 0 = تجربة محلية فقط
FORCE_HTTPS=1

# منفذ اللوحة (البوت يشغّلها تلقائياً)
DASHBOARD_PORT=25591

# مفتاح الجلسات — اختياري (إن تركته فاضي يُولَّد تلقائياً ويُحفظ في .session_secret)
SESSION_SECRET=

# اختياري: البروكسي الموثوق الذي يرسل X-Forwarded-Proto (* = الكل)
FORWARDED_ALLOW_IPS=*

# اختياري: https مباشر بدون بروكسي (ضع مسار الشهادة)
# SSL_CERTFILE=/etc/letsencrypt/live/dashboard.example.com/fullchain.pem
# SSL_KEYFILE=/etc/letsencrypt/live/dashboard.example.com/privkey.pem
