# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى GitHub
# Copy to .env and fill in — never commit .env

# ===== البوت | Bot =====
# توكن البوت (من Developer Portal → Bot)
DISCORD_TOKEN=
# البوت عربي بالكامل (1). ضع 0 لو تبي خيار English لكل سيرفر
ARABIC_ONLY=1
# اللغة الافتراضية لو ARABIC_ONLY=0: ar أو en
DEFAULT_LANG=ar
# آيديات المالكين مفصولة بفاصلة (اختياري)
OWNER_IDS=
# سيرفرك الخاص لأوامر /bot-control وإشعارات دخول البوت (اختياري)
OWNER_GUILD_ID=
# روم إشعارات دخول/خروج البوت (اختياري)
OWNER_LOG_CHANNEL_ID=
# روم الإحصائيات الحية (اختياري)
OWNER_STATS_CHANNEL_ID=
# مجلد البيانات (الافتراضي: data/)
DATA_DIR=

# ===== لوحة التحكم | Dashboard =====
ENABLE_DASHBOARD=1
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# الدومين الرسمي (https) — Redirect: <هذا>/callback
DASHBOARD_URL=https://dashboard.example.com
FORCE_HTTPS=1
DASHBOARD_PORT=25591
SESSION_SECRET=
FORWARDED_ALLOW_IPS=*
SUPPORT_URL=https://discord.gg/xxxx
# SSL_CERTFILE=/etc/letsencrypt/live/dashboard.example.com/fullchain.pem
# SSL_KEYFILE=/etc/letsencrypt/live/dashboard.example.com/privkey.pem

# تسجيل الإيموجيات تلقائياً عند التشغيل (0 للإيقاف)
AUTO_EMOJIS=1
