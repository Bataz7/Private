# ============================================================
#  Rift — ملف الإعدادات. انسخه باسم .env وعبّ القيم.
#  البوت لسيرفر واحد بس.
# ============================================================

# ---- ديسكورد (مطلوب) ----
# توكن البوت من Discord Developer Portal > Bot
DISCORD_TOKEN=your_discord_bot_token
# آيدي التطبيق (Application ID)
CLIENT_ID=your_discord_application_id
# آيدي السيرفر. الأوامر تتسجّل عليه كأوامر سيرفر (تظهر فوراً)، وأي سيرفر ثاني يتجاهله البوت.
# لو تركته فاضي: البوت يعتمد أول سيرفر هو فيه ويطلع تنبيه وقت التشغيل.
GUILD_ID=your_server_id
# سر OAuth (لتسجيل الدخول في الداشبورد)
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# ---- Supabase (مطلوب) ----
SUPABASE_URL=https://your-project.supabase.co
# المفتاح السري (للبوت والسيرفر بس، لا تحطه في المتصفح)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# اختياري: للداشبورد
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ---- الداشبورد ----
# العنوان العام مع https:// وبدون / في الآخر. مثال: https://rift.example.com
# في Discord Developer Portal (OAuth2 > Redirects) أضف بالضبط: <DASHBOARD_URL>/auth/callback
# لو محطوط، بطاقة الستاف يطلع فيها زر «فتح في الداشبورد».
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
# اختياري: العنوان اللي يسمع عليه السيرفر (الافتراضي كل الواجهات)
# DASHBOARD_HOST=0.0.0.0

# 32 حرف عشوائي على الأقل. الداشبورد يرفض يشتغل بقيمة قصيرة أو افتراضية.
# تقدر تسويه بـ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_value
# اختياري: مدة الجلسة بالساعات، ودقائق الخمول قبل تسجيل الخروج، وأقصى عدد جلسات
# SESSION_MAX_HOURS=168
# SESSION_IDLE_MINUTES=720
# SESSION_MAX=500

# اختياري. ورا دومين بـ https الداشبورد يثق ببروكسي واحد (لوحة الاستضافة، Nginx، Cloudflare).
# حط TRUST_PROXY=0 بس لو الدومين يأشر على التطبيق مباشرة بدون بروكسي.
# TRUST_PROXY=1

# ---- تشغيل وذاكرة (اختياري) ----
# كل كم ملي ثانية يجمع القمامة (يبقي البوت تحت 20 ميقا)
# GC_INTERVAL_MS=30000
# كل كم ملي ثانية يقرأ حالة البوت من الداشبورد
# PRESENCE_POLL_MS=15000
# حدود الكاش في الذاكرة (أعضاء ومستخدمين)
# MEMBER_CACHE=
# USER_CACHE=
# مراقب الحالة (heartbeat)
# STATUS_MONITOR=
# سجلات تفصيلية للتشخيص
# DEBUG=
# RIFT_MEMDEBUG=
# NODE_ENV=production

# ---- للتطوير والاختبار بس (لا تحطها في الإنتاج) ----
# عناوين بديلة لـ Discord (المحاكي في scripts/mock-discord.ts)
# DISCORD_API_BASE=http://127.0.0.1:38011/api/v10
# DISCORD_GATEWAY_URL=ws://127.0.0.1:38011/gw
