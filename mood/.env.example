# ── أساسي ──
# توكن البوت من https://discord.com/developers/applications
DISCORD_TOKEN=
# ID الشخص اللي يوصله السؤال كل يوم (تقدر تحط أكثر من واحد: 111,222)
TARGET_USER_ID=
# ID حقك أنت (تشوف تقاريره وتوصلك التقارير الأسبوعية)
OWNER_ID=

# ── الوقت ──
TIMEZONE=Asia/Riyadh
# وقت السؤال اليومي بصيغة 24 ساعة (14:30 = 2:30 الظهر، 02:30 = 2:30 الفجر)
CHECKIN_TIME=14:30
# تذكير لو ما رد بعد كم ساعة (0 = بدون تذكير)
REMINDER_AFTER_HOURS=3
# يوم التقرير الأسبوعي: 0=الاثنين 1=الثلاثاء 2=الأربعاء 3=الخميس 4=الجمعة 5=السبت 6=الأحد
WEEKLY_REPORT_DAY=4
WEEKLY_REPORT_TIME=21:00
# يوصلك إشعار قصير كل ما سجّل الشخص يومه؟
NOTIFY_OWNER=false

# ── الذكاء الاصطناعي (اختياري) ──
# مفتاح من https://console.anthropic.com — بدونه البوت يشتغل عادي بردود جاهزة
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
