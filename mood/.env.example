# ════════════════ أساسي (لازم) · Required ════════════════
# توكن البوت: https://discord.com/developers/applications ← Bot ← Reset Token
DISCORD_TOKEN=
# ID الشخص اللي يوصله السؤال كل يوم (تقدر تحط أكثر من واحد: 111,222)
TARGET_USER_ID=
# ID حقك أنت: تشوف تقاريره وتوصلك التقارير والتنبيهات (تقدر تحط أكثر من واحد)
OWNER_ID=

# ════════════════ اللغة · Language ════════════════
# اللغة الافتراضية: ar أو en (وكل شخص يقدر يغيّر لغته بـ /language)
DEFAULT_LANG=ar

# ════════════════ الذكاء الاصطناعي (اختياري) · AI (optional) ════════════════
# OpenRouter (يدعم كل الموديلات: openai/gpt-4o، anthropic/claude-…، google/gemini-…)
# المفتاح من https://openrouter.ai/keys
OPENROUTER_API_KEY=
# الموديل (افتراضي openai/gpt-4o)
AI_MODEL=openai/gpt-4o
# أو بدل OpenRouter: OPENAI_API_KEY=…  أو  ANTHROPIC_API_KEY=…
# (البوت يختار تلقائياً حسب المفتاح الموجود، أو حدد AI_PROVIDER=openrouter|openai|anthropic|none)
# AI_PROVIDER=auto
# لأي API متوافق مع OpenAI (مثل Ollama محلي): AI_BASE_URL=http://localhost:11434/v1
# دردشة حرة في الخاص مع البوت
AI_CHAT=true

# ════════════════ قاعدة البيانات · Database ════════════════
# فاضي = SQLite (ملف data/mood.db، بدون أي تثبيت) ← الأسهل
# PostgreSQL:  DATABASE_URL=postgres://user:pass@host:5432/mood       (npm install pg)
# MySQL:       DATABASE_URL=mysql://user:pass@host:3306/mood          (npm install mysql2)
# MongoDB:     DATABASE_URL=mongodb+srv://user:pass@cluster.x.mongodb.net/mood   (npm install mongodb)
DATABASE_URL=

# ════════════════ الوقت · Time ════════════════
TIMEZONE=Asia/Riyadh
# وقت السؤال اليومي بصيغة 24 ساعة: 14:30 = 2:30 الظهر · 02:30 = 2:30 الفجر
CHECKIN_TIME=14:30
# تذكير لو ما رد بعد كم ساعة (0 = بدون تذكير)
REMINDER_AFTER_HOURS=3
# التقرير الأسبوعي: اليوم (friday أو الجمعة) والوقت
WEEKLY_REPORT_DAY=friday
WEEKLY_REPORT_TIME=21:00
# تقرير شهري أول كل شهر (نفس وقت التقرير الأسبوعي)
MONTHLY_REPORT=true

# ════════════════ التنبيهات · Alerts ════════════════
# تنبيه المالك لو المزاج سيء كذا يوم ورا بعض، أو لو انكتب كلام مقلق
ALERTS=true
LOW_MOOD_ALERT_DAYS=3
# إشعار قصير للمالك كل ما سجّل الشخص يومه
NOTIFY_OWNER=false

# ════════════════ متقدم · Advanced ════════════════
# مكان الملفات (SQLite، التقارير، النسخ الاحتياطية)
DATA_DIR=./data
# كم نسخة احتياطية يومية نخلي (0 = بدون)
BACKUP_KEEP=14
# debug | info | warn | error
LOG_LEVEL=info
# الحالة اللي تطلع تحت اسم البوت
STATUS_TEXT=كيف كان يومك؟ 🌈
# يظهر في لوحة OpenRouter (اختياري)
APP_NAME=Mood Bot
APP_URL=https://github.com/bataz7/private
