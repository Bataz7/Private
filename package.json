{
  "name": "revive",
  "version": "3.0.0",
  "description": "ريفايف — بوت ديسكورد عربي (TypeScript على Bun) + لوحة تحكم TSX",
  "type": "module",
  "private": true,
  "imports": {
    "#jsx/jsx-runtime": "./dashboard/jsx/jsx-runtime.ts",
    "#jsx/jsx-dev-runtime": "./dashboard/jsx/jsx-runtime.ts"
  },
  "scripts": {
    "start": "bash start.sh",
    "start:bun": "BUN_JSC_useDFGJIT=0 BUN_JSC_useFTLJIT=0 bun --smol src/index.ts",
    "start:tjs": "runtime/tjs run dist/revive.js",
    "dev": "bun --smol --watch src/index.ts",
    "build": "bun scripts/build.ts",
    "build:runtime": "bash runtime/txiki/build.sh",
    "dashboard": "BUN_JSC_useDFGJIT=0 BUN_JSC_useFTLJIT=0 bun --smol dashboard/server.tsx",
    "typecheck": "tsc --noEmit",
    "test": "for f in tests/*.test.ts; do bun test \"$f\" || exit 1; done",
    "check": "tsc --noEmit && bun run test",
    "memtest": "bash scripts/memtest.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
