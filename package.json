{
  "name": "staff-management-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Discord Staff Management Bot with shifts, leave requests, resignations, and reports. Powered by Supabase.",
  "type": "module",
  "scripts": {
    "emojis": "node scripts/build-emojis.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:dashboard": "tsx watch src/dashboard/server.ts",
    "start:dashboard": "tsx src/dashboard/server.ts",
    "start:all": "tsx scripts/start-all.ts",
    "audit": "node scripts/audit-permissions.mjs",
    "build": "tsc",
    "register": "tsx scripts/register-commands.ts",
    "brand": "node scripts/build-brand.mjs",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@supabase/server": "^1.6.1",
    "@supabase/supabase-js": "^2.116.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.17.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "iconsax": "^0.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
